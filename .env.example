# Copy to apps/web/.env.local. Every value is optional for local dev:
# without them the app uses an in-process Postgres (PGlite), logs texts to the console,
# and uses the heuristic (non-AI) extractor.

# Postgres (Supabase). Unset → PGlite under apps/web/.data/pglite
DATABASE_URL=
# Signs session + personal-link cookies (32+ random bytes, base64)
SESSION_SECRET=
APP_URL=http://localhost:3000

# Claude API (extraction + receipts). Default model: claude-opus-5-5
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Google Places (New) + Maps JS
GOOGLE_MAPS_API_KEY=
# Optional separate key for Places (New); falls back to GOOGLE_MAPS_API_KEY
GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Twilio: messaging number for trip texts, Verify service for codes (separate number, FR-85)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=
SMS_DAILY_SPEND_CAP_CENTS=2000

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Supabase Storage (receipts, screenshots)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Observability
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=

# Web platform extras
TWILIO_INBOUND_URL=
SUPPORT_EMAIL=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Instrumentation (§11, §12)
POSTHOG_HOST=
ADMIN_USER_IDS=
COST_AI_IMPORT_MICROS=30000

# Receipts (§6.5): private Supabase Storage bucket (create it as PRIVATE). Without
# SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY, photos go to apps/web/.data/uploads (or
# WANDR_UPLOADS_DIR) and are served only through an authenticated route.
RECEIPTS_BUCKET=receipts
WANDR_UPLOADS_DIR=
# Exchange rates for the approximate display total only (FR-66). Default https://api.frankfurter.dev/v1
FRANKFURTER_URL=
