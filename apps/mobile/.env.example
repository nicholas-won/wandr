# Copy to apps/mobile/.env.local. EXPO_PUBLIC_* values are baked into the bundle: no secrets here.

# 1 = run against in-memory fixtures (no server). Sign in with any number and code 000000.
EXPO_PUBLIC_API_MOCK=1

# Base URL of the web app that serves /api/v1 (D75). The iOS simulator can reach localhost;
# a real phone needs your machine's LAN address, e.g. http://192.168.1.20:3000.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Website opened from Settings ("Open the website"). Defaults to EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_WEB_URL=

# EAS project id, needed for Expo push tokens (FR-87). Push registration is skipped without it.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional: override the iOS bundle id / Android package (default app.wandr.mobile).
WANDR_BUNDLE_ID=
